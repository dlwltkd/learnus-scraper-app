api.dlwltkd.com {
	reverse_proxy api:8000
}

luconnect.dlwltkd.com {
	handle_path /api/* {
		reverse_proxy api:8000
	}

	handle /_expo/static/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /srv
		try_files {path} /index.html
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}
}
