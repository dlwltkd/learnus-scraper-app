{
  "manifest_version": 3,
  "name": "LearnUs Connect (개발용)",
  "version": "0.1.1",
  "description": "연세대학교 LearnUs 로그인 후, 이 브라우저를 로컬 LearnUs Connect 서버에 연결해요.",
  "minimum_chrome_version": "109",
  "incognito": "not_allowed",
  "permissions": [
    "cookies"
  ],
  "host_permissions": [
    "https://ys.learnus.org/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "LearnUs Connect · 브라우저 연결 (개발용)",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
