# Required by Docker Compose
POSTGRES_PASSWORD=replace-with-a-strong-password

# Required for transcription, summaries, chat, and flashcards
OPENAI_API_KEY=

# Optional API limits
DAILY_CHAT_LIMIT=30
DAILY_TRANSCRIBE_LIMIT=3
TRANSCRIBE_BYPASS_USERS=
TRANSCRIBE_BYPASS_TOKENS=

# Optional worker settings
WORKER_MAX_CONCURRENCY=4
TRANSCRIBE_TIMING_LOG_ENABLED=true
TRANSCRIBE_TIMING_LOG_PATH=/app/error_log/transcribe_timing.jsonl

# Lab access. Comma-separated usernames (e.g. moodle_12345) permitted to unlock the
# experimental features, which spend money on transcription. Empty means nobody new can
# unlock; accounts already unlocked are unaffected.
LABS_ALLOWED_USERS=

# Days an issued API token stays valid. 0 disables expiry.
API_TOKEN_TTL_DAYS=30

# Browser sessions established by the LearnUs SSO helper extension.
WEB_ALLOWED_ORIGINS=https://luconnect.dlwltkd.com
WEB_LOGIN_TICKET_TTL_SECONDS=90
WEB_SESSION_TTL_DAYS=7
WEB_SESSION_COOKIE_NAME=__Host-luconnect_session
WEB_SESSION_COOKIE_SECURE=true
